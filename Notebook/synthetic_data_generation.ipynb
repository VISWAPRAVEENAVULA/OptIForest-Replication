# Synthetic Dataset Generation for OptIForest
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import make_blobs

# Generate normal data
X_normal, _ = make_blobs(n_samples=9500, centers=3, n_features=2, random_state=42)
X_outliers = np.random.uniform(low=-10, high=10, size=(500, 2))
X_full = np.vstack([X_normal, X_outliers])
y_full = np.hstack([np.zeros(9500), np.ones(500)])

# Save dataset
df_synthetic = pd.DataFrame(X_full, columns=['Feature1', 'Feature2'])
df_synthetic['Class'] = y_full.astype(int)
df_synthetic.to_csv("synthetic_data.csv", index=False)

# Plot dataset
plt.figure(figsize=(6, 6))
plt.scatter(df_synthetic['Feature1'], df_synthetic['Feature2'], c=df_synthetic['Class'], cmap='coolwarm', alpha=0.6)
plt.title("Synthetic Dataset (Normal vs Outliers)")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.show()

print(df_synthetic.head())
